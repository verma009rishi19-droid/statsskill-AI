# StatSkill AI — Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/statskill_ai_db

# Security
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Provider (Gemini API)
GEMINI_API_KEY=
AI_PROVIDER=gemini

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173

# iGOT Karmayogi Integration (optional)
IGOT_API_BASE_URL=
IGOT_API_KEY=
